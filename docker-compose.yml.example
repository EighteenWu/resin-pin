services:
  resin-pin:
    build: .
    container_name: resin-pin
    restart: unless-stopped
    environment:
      RESIN_URL: http://host.docker.internal:2260
      RESIN_ADMIN_TOKEN: "${RESIN_ADMIN_TOKEN}"
      RESIN_PROXY_TOKEN: "${RESIN_PROXY_TOKEN}"
      RESIN_PUBLIC_HOST: pin.example.com
      RESIN_PUBLIC_PORT: "2260"
      PIN_LISTEN: 0.0.0.0:2270
      PIN_STATE_PATH: /data/state.json
      PIN_SYNC_ON_START: "true"
      PIN_SYNC_INTERVAL_SECONDS: "86400"
      PIN_REGIONS: tw,jp,hk,sg
    ports:
      - "2270:2270"
    volumes:
      - ./data:/data
    extra_hosts:
      - "host.docker.internal:host-gateway"
